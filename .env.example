# Copy this file to ".env" and fill in what you use. Lines starting with # are ignored.
# LLM_BACKEND=ollama            # ollama | gemini | template
# OLLAMA_MODEL=llama3.1:8b
# GEMINI_API_KEY=your-key-here

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Discord (optional): channel webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123/abc...

# ntfy push (optional): a long random topic name; keep it private
# NTFY_TOPIC=n-replace-with-random
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=tk_...              # only for protected/self-hosted topics
# NTFY_PRIORITY=3                # 1-5

# Email (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com

# Print counts only
# QUIET=1
